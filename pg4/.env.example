# pg4 — Environment Variables
# Copy this file to `.env` and fill in the keys you have. Missing optional keys
# do NOT fail startup; the corresponding provider is silently dropped from the
# registry and logged at boot.

# ============================================================
# CORE
# ============================================================
NODE_ENV=development
LOG_LEVEL=info                        # trace | debug | info | warn | error
LOG_FORMAT=pretty                     # pretty (dev) | json (prod)

# ============================================================
# PIPELINE TUNING (override defaults from src/config/defaults.ts)
# ============================================================
# CONCURRENCY=4
# COST_CEILING_EUR_PER_LEAD=0.10
# REQUEST_TIMEOUT_MS=8000

# ============================================================
# SERP PROVIDERS — paid (all optional, all gated by feature flag)
# ============================================================
# SERPER_ENABLED=false
# SERPER_API_KEY=
# EXA_ENABLED=false
# EXA_API_KEY=
# TAVILY_ENABLED=false
# TAVILY_API_KEY=
# PERPLEXITY_ENABLED=false
# PERPLEXITY_API_KEY=

# ============================================================
# HTTP FALLBACKS — paid (all optional)
# ============================================================
# BRIGHTDATA_ENABLED=false
# BRIGHTDATA_API_KEY=
# FIRECRAWL_ENABLED=false
# FIRECRAWL_API_KEY=
# ORACLE_CRAWL4AI_URL=                # http://localhost:8080 if running local Oracle

# ============================================================
# LLM PROVIDERS — at least one needed for HyperGuesser AI triage / municipality_splitter
# ============================================================
# OPENAI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_ENABLED=false
# OPENROUTER_API_KEY=
# DEEPSEEK_ENABLED=false
# DEEPSEEK_API_KEY=

# ============================================================
# ENRICHMENT EXTRAS
# ============================================================
# HUNTER_ENABLED=false
# HUNTER_API_KEY=

# ============================================================
# BROWSER
# ============================================================
# PLAYWRIGHT_HEADLESS=true
# PATCHRIGHT_ENABLED=false            # use patchright instead of playwright

# ============================================================
# TESTING
# ============================================================
# RUN_SMOKE=0                         # 1 to enable network-touching smoke tests
