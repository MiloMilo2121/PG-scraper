# ─────────────────────────────────────────────────────────────────────────────
# 🐳 OMEGA V9: DOCKER PARITY CONFIGURATION
# Task 4.3: Total Environmental Parity for Padova Datacenter Node
#
# Law 101: Immutable Infrastructure — no SSH, no manual config.
# Law 102: Containerization — all environments must match.
# Law 103: Statelessness — volatile local fs, persist via DB/Redis/S3.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-slim

# ─── SYSTEM CONFIGURATION (Padova Node Parity) ──────────────────────────────

# Lock timezone to Europe/Rome (Padova datacenter alignment)
ENV TZ=Europe/Rome
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Browser dependencies (Playwright Chromium + possible Camoufox)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    # Italian locale for proper string sorting (Law 402)
    locales \
    && rm -rf /var/lib/apt/lists/*

# Generate Italian locale
RUN echo "it_IT.UTF-8 UTF-8" >> /etc/locale.gen && locale-gen
ENV LANG=it_IT.UTF-8
ENV LC_ALL=it_IT.UTF-8

# ─── APPLICATION ─────────────────────────────────────────────────────────────

WORKDIR /app

# Install dependencies (cached layer)
COPY package.json package-lock.json ./
RUN npm ci --production=false

# Install Playwright browsers (Chromium for Patchright, Firefox for Camoufox)
RUN npx playwright install chromium firefox

# Copy source
COPY . .

# Build TypeScript
RUN npm run build

# ─── RUNTIME CONFIGURATION ──────────────────────────────────────────────────

ENV RUNNING_IN_DOCKER=true
ENV NODE_ENV=production

# Hardware fingerprint parity (match Padova server specs)
# These are used by GeneticFingerprinter for consistency checks
ENV DOCKER_HARDWARE_CONCURRENCY=8
ENV DOCKER_DEVICE_MEMORY=8
ENV DOCKER_PLATFORM=linux
ENV DOCKER_SCREEN_WIDTH=1920
ENV DOCKER_SCREEN_HEIGHT=1080

# Healthcheck (Law 108)
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD node -e "process.exit(0)" || exit 1

# ─── ENTRYPOINT ──────────────────────────────────────────────────────────────

CMD ["node", "dist/main.js"]
